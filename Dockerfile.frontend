# Multi-Stage Build for Vision79 Frontend
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package descriptors
COPY package*.json ./

# Install development & production dependencies for building
RUN npm ci

# Copy application source code
COPY . .

# Compile static assets
RUN npm run build

# Stage 2: Serve compiled assets using Nginx
FROM nginx:alpine

# Copy built artifacts from stage 1
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration for the frontend
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Expose production port 3010 for frontend container
EXPOSE 3010

CMD ["nginx", "-g", "daemon off;"]
