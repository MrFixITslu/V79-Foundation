# Multi-Stage Build for Vision79 Frontend Server
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package descriptors
COPY package*.json ./

# Install all dependencies for building (vite, esbuild, etc.)
RUN npm install

# Copy application source code
COPY . .

# Build frontend SPA and bundle server-frontend.ts
RUN npm run build

# Stage 2: Clean and lightweight runner
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3081

# Copy package descriptors
COPY package*.json ./

# Install production dependencies only
RUN npm install --omit=dev

# Copy compiled server bundle and static assets from builder stage
COPY --from=builder /app/dist ./dist

# Secure files ownership and transition to non-privileged user
RUN chown -R node:node /app
USER node

# Expose production port 3081 for frontend container
EXPOSE 3081

# Run frontend static server bundle
CMD ["node", "dist/server-frontend.cjs"]
