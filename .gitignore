data.json
db.sqlite
*.db

# Security & Secrets (NEVER upload keys, credentials, or local configs to Git)
.env
.env.local
.env.development
.env.test
.env.production
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
*.cert
*.pfx
*.p12
secrets.json
credentials.json
firebase-key.json
service-account*.json
.git-credentials

# Keep environment examples tracked for configuration templates
!.env.example
!.env.production.example
