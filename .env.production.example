# =========================================================================
# Vision79 Foundation App - Production Environment Variables Configuration
# =========================================================================

# Port configured inside the backend container (Port 3080)
PORT=3080

# Target Production Environment
NODE_ENV=production

# Google GenAI API Key (Set in secure container manager)
GEMINI_API_KEY=your_production_gemini_api_key_here

# FFPRO2 Integration Key
# Primary secure token for Downstream Planner handshake & Milestones Sync
FFPRO2_API_KEY=your_secured_production_ffpro2_token_here
