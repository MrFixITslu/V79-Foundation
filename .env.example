# =========================================================================
# Vision79 Foundation App - Development Environment Variables Configuration
# =========================================================================

# Port configuration (Port 3000 used by developer environment default proxy)
PORT=3000

# Target Environment
NODE_ENV=development

# Google GenAI API Key (Required for AI powered recommendations)
GEMINI_API_KEY=

# FFPRO2 Integration Key
# Used for backend authentication with downstream project planner API
FFPRO2_API_KEY=ffpro2_secret_key_123
